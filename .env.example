# Xbot Docker Compose 参数示例。
# 使用方式：cp .env.example .env，然后填写真实值。不要提交 .env。

TZ=Asia/Shanghai

TELEGRAM_BOT_TOKEN=123456:replace_me
TELEGRAM_ADMIN_USER_ID=123456789
# 多个 ID 用英文逗号分隔，例如：123,456
TELEGRAM_MANAGER_USER_IDS=
TELEGRAM_AUTHORIZED_USER_IDS=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 建议使用只有 SELECT 权限的只读账号。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=xboard
MYSQL_USERNAME=xbot_readonly
MYSQL_PASSWORD=replace_me
